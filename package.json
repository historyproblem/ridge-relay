{
  "name": "ridge-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An authoritative LAN tank arena with destructible cover and FPV reconnaissance drones.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": { "three": "0.180.0", "ws": "8.18.3" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
